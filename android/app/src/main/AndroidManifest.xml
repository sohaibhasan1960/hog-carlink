<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="true" />
    <!-- выбор машины (автостарт беспровода по Bluetooth); без CDM приложение работает, только без привязки -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- звонки и журнал вызовов для карточки «Телефон» лаунчера; без телефонии (планшет) приложение ставится, карточка пустая -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- AA-режим: TCP на loopback к серверу ГУ Android Auto (127.0.0.1:5277) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- HOG CarLink: азан, икама и азкары по местному времени (prayer/): будильники, звук как медиа, пересчёт после перезагрузки -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- одно из условий для foreground-сервиса connectedDevice; обычное разрешение, выдаётся при установке -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Wi-Fi машины (WifiNetworkSpecifier) и признак STA+STA; обычные разрешения, выдаются при установке -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- какие интерфейсы Wi-Fi заняты телефоном-клиентом, а какие хотспотом (h420); обычное разрешение -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 17 (targetSdk 37): локальная сеть (входящий TCP беспроводного CarLife, UDP-маяк 7999/8999, mDNS-поиск портов
         отладки по Wi-Fi при активации с телефона). Loopback (AA 5277, debug, adbd своего телефона) не требует. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- беспровод, ветка A (диагностика): RFCOMM-сервер carlife, ГУ подключается сама; старые разрешения до Android 11 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- беспровод, ветка A: вход в Wi-Fi Direct-группу ГУ (WifiP2pManager.connect); до Android 13 вместо него геолокация -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- HOG CarLink: без maxSdkVersion - список сетей рядом (WifiScan) требует геолокацию и на Android 13+ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12: запрос одной FINE без COARSE система молча отклоняет -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- привязка машины через CompanionDeviceManager: исключения на запуск foreground-сервиса и работу в фоне; обычные разрешения -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- HOG CarLink: присутствие машины будит CarPresenceService (CDM), параллельно ACL -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <!-- HOG CarLink: QR-code of the car Wi-Fi from the head unit screen (ui/QrScan); asked only when the button is pressed -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- микрофон телефона как запасной источник звука для AA (режим «авто»/«телефон») -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- h428: состояние звонка для ГУ (MODULE_STATUS PHONE / TELE_STATE), как Baidu -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- карточка «Телефон» лаунчера Headswap Desktop: журнал вызовов, контакты, звонок и ответ с экрана ГУ; обычные runtime-разрешения,
         запрашиваются кнопкой в разделе Режим/Рабочий стол -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- онбординг: запрос исключения из оптимизации батареи (HyperOS убивает фон) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- обновление из приложения: установка скачанного с GitHub APK через PackageInstaller -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- без queries на API 30+ пакет Android Auto не виден (проверка установки, запуск настроек) -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <!-- раздел «Приложения для магнитолы»: статус установки и запуск каталога (Fermata Auto, ParkedTube, AABrowser) -->
        <package android:name="me.aap.fermata.auto.dear.google.why" />
        <package android:name="dev.codex.aaparkedyoutube" />
        <package android:name="com.kododake.aabrowser" />
        <!-- поиск любых приложений для Android Auto: плееры (сервис) и полноэкранные (activity) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.CAR_LAUNCHER" />
        </intent>
        <!-- рабочий стол с компьютерной активацией: список и проверка запускаемых приложений для встроенных окон -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- лаунчер Headswap Desktop: выбор стороннего рабочего стола (DriveDeck, CarDash) - входы под HOME; LAUNCHER выше -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- лаунчер Headswap Desktop: список музыкальных плееров (MediaBrowserService) для переключателя на карточке музыки -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- Только явная активация с компьютера (adb shell -> am instrument с токеном из приложения).
         Цель - главный процесс приложения, не :delegated. Токен сверяется до выдачи любых прав.
         Имя полное: AGP не раскрывает относительное имя в instrumentation, а в сборке .smoke оно
         разрешилось бы от applicationId, а не от namespace. -->
    <instrumentation
        android:name="com.yegorkapomidorka.headswap.dex.DelegatedDesktopInstrumentation"
        android:targetPackage="${applicationId}"
        android:functionalTest="true"
        android:handleProfiling="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:name=".HeadswapApp"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.Headswap">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!-- раздача логов и отчётов через «Поделиться» (только чтение, без AndroidX FileProvider) -->
        <provider
            android:name=".ui.LogProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Домашний экран Headswap Desktop (лаунчер на Compose): его запускает :delegated (тот же uid) на виртуальном дисплее ГУ,
             снаружи не нужен; домашним приложением телефона не становится. launchMode как у форка не задан (стандартный). -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.desktop"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Headswap.Desktop" />

        <!-- кнопка «Стоп» в уведомлении -->
        <receiver
            android:name=".ui.StopReceiver"
            android:exported="false" />

        <!-- автостарт беспровода: ACL выбранной машины; выключен, пока машина не выбрана (CarProfile.enableTrigger) -->
        <receiver
            android:name=".link.car.CarAclReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- HOG CarLink: система привязывает сервис, когда выбранная машина подключилась по Bluetooth -->
        <service
            android:name=".link.car.CarPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- HOG CarLink: фоновая проверка запросов поддержки (JobScheduler) -->
        <service
            android:name=".support.SupportJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- статус установки обновления (PackageInstaller) -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- HOG CarLink: статус установки приложений для машины (AABrowser, Fermata) -->
        <receiver
            android:name=".apps.CarAppInstallReceiver"
            android:exported="false" />

        <!-- HOG CarLink: будильники намаза и их пересчёт при смене времени/пояса, перезагрузке, обновлении -->
        <receiver
            android:name=".prayer.PrayerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- HOG CarLink: звук азана, икамы и азкаров -->
        <service
            android:name=".prayer.PrayerPlayer"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- HOG CarLink: «Намаз и азкары» на экране машины (медиа-приложение Android Auto) -->
        <service
            android:name=".prayer.AdhkarMediaService"
            android:exported="true"
            android:label="@string/pr_title">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- microphone: только на время захвата микрофона телефона (fallback AA-микрофона); тип в runtime выбирает сервис -->
        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- активация Headswap Desktop с самого телефона: сопряжение с отладкой по Wi-Fi, код вводится в уведомлении -->
        <service
            android:name=".dex.PhoneActivationService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- производитель рабочего стола (виртуальный экран) в отдельном процессе: его гибель не обрывает активацию в главном -->
        <service
            android:name=".dex.DelegatedDesktopService"
            android:exported="false"
            android:process=":delegated" />
    </application>
</manifest>
