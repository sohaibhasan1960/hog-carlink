    <!-- HOG CarLink: активация входом Google (ui/AccountScreen) -->
    <string name="acc_title">Активация HOG CarLink</string>
    <string name="acc_why">Войдите через аккаунт Google, чтобы активировать приложение. Подключение к машине работает только после входа, а запросы в поддержку привязаны к аккаунту.</string>
    <string name="acc_note">Используются только имя и почта. Нужно один раз на телефон.</string>
